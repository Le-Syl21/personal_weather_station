{
  "config": {
    "step": {
      "user": {
        "title": "Persónuleg veðurstöð",
        "description": "Stilltu hér stöðvarlykil sem veðurstöðvarnar þínar verða að senda svo gögnum þeirra sé ekki hafnað. Ef þú skilur reitinn eftir auðan verða allar beiðnir samþykktar.",
        "data": {
          "password": "Stöðvarlykill"
        }
      }
    },
    "abort": {
      "single_instance_allowed": "Þegar uppsett. Eitt eintak þjónar öllum veðurstöðvum."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Persónuleg veðurstöð",
        "description": "Stilltu hér stöðvarlykil sem veðurstöðvarnar þínar verða að senda svo gögnum þeirra sé ekki hafnað. Ef þú skilur reitinn eftir auðan verða allar beiðnir samþykktar.",
        "data": {
          "password": "Stöðvarlykill",
          "availability_timeout": "Merkja sem ótiltækt eftir (mínútur)",
          "debug": "Skrá hverja innkomna beiðni"
        },
        "data_description": {
          "availability_timeout": "Hversu lengi stöð má þegja áður en nemar hennar eru merktir ótiltækir. 0 til að merkja þá aldrei.",
          "debug": "Skrifar allt innihald hverrar beiðni í annál Home Assistant. Gagnlegt meðan stöð er sett upp, hávaðasamt eftir það."
        }
      }
    }
  },
  "issues": {
    "invalid_station_key": {
      "title": "Veðurstöð hafnað: rangur stöðvarlykill",
      "description": "Veðurstöð á {ip} reyndi að senda gögn sem `{station_id}` án þess að senda væntanlegan stöðvarlykil.\n\nAthugaðu hvort lykillinn sem stilltur er í stöðinni eða í WSLink-forritinu passi við þann sem stilltur er í þessari samþættingu. Þessi skilaboð hverfa af sjálfu sér um leið og beiðni frá {ip} er samþykkt."
    },
    "missing_device_id": {
      "title": "Veðurstöð hafnað: engin stöðvarauðkenni",
      "description": "Veðurstöð á {ip} sendi gögn án stöðvarauðkennis.\n\nStilltu Sender ID í WSLink-forritinu, eða ID-færibreytu í stillingum stöðvarinnar. Þessi skilaboð hverfa af sjálfu sér um leið og beiðni frá {ip} er samþykkt."
    },
    "legacy_entity_ids": {
      "title": "Entity IDs repeat the station name",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Shorten the entity IDs",
            "description": "Up to version 1.0.8 this integration built entity IDs that carry the station name twice, such as `{example_old}`. New stations no longer do.\n\n**{count} entities** can be renamed, for example to `{example_new}`.\n\nHistory and long-term statistics follow the rename automatically. **Automations, scripts, scenes and dashboards do not** — you will have to update anything that refers to the old IDs yourself.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    },
    "legacy_status_sensors": {
      "title": "Connection and leak readings are still numbers",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Convert to binary sensors",
            "description": "Connection and water leak readings are reported as 1 or 0. Up to version 1.0.8 they were exposed as numeric sensors, such as `{example}`, which cannot be used with the standard leak cards and alerts of Home Assistant. New stations now get binary sensors showing **Wet / Dry** and **Connected / Disconnected**.\n\n**{count} entities** can be converted. Battery levels are not affected: they stay percentages, where the low-battery alerts work on them.\n\nChanging platform is not a rename, so the old entities are removed and rebuilt as `binary_sensor`. **Their recorded history is lost** — these readings have no long-term statistics, so only the raw history is affected — and **automations, scripts, scenes and dashboards pointing at them must be updated**. The new entities appear on the station's next upload.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    }
  },
  "exceptions": {
    "no_wind_direction": {
      "message": "Stöðin {device} hefur ekki enn sent neina vindátt, svo það er ekkert til að kvarða eftir. Bíddu eftir næstu sendingu og reyndu aftur."
    }
  },
