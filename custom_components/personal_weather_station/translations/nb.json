{
  "config": {
    "step": {
      "user": {
        "title": "Personlig værstasjon",
        "description": "Angi her en stasjonsnøkkel som værstasjonene dine må sende med for at dataene deres ikke skal bli avvist. Lar du feltet stå tomt, godtas alle forespørsler.",
        "data": {
          "password": "Stasjonsnøkkel"
        }
      }
    },
    "abort": {
      "single_instance_allowed": "Allerede konfigurert. Én enkelt instans betjener alle værstasjoner."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Personlig værstasjon",
        "description": "Angi her en stasjonsnøkkel som værstasjonene dine må sende med for at dataene deres ikke skal bli avvist. Lar du feltet stå tomt, godtas alle forespørsler.",
        "data": {
          "password": "Stasjonsnøkkel",
          "availability_timeout": "Merk som utilgjengelig etter (minutter)",
          "debug": "Logg hver innkommende forespørsel"
        },
        "data_description": {
          "availability_timeout": "Hvor lenge en stasjon kan være taus før sensorene merkes som utilgjengelige. 0 for aldri å merke dem.",
          "debug": "Skriver hele innholdet i hver forespørsel til Home Assistant-loggen. Nyttig mens en stasjon settes opp, støyende etterpå."
        }
      }
    }
  },
  "issues": {
    "invalid_station_key": {
      "title": "Værstasjon avvist: feil stasjonsnøkkel",
      "description": "En værstasjon på {ip} forsøkte å sende data som `{station_id}` uten å sende med forventet stasjonsnøkkel.\n\nKontroller at nøkkelen som er satt i stasjonen eller i WSLink-appen stemmer med den som er angitt i denne integrasjonen. Meldingen forsvinner av seg selv så snart en forespørsel fra {ip} godtas."
    },
    "missing_device_id": {
      "title": "Værstasjon avvist: ingen stasjonsidentifikator",
      "description": "En værstasjon på {ip} sendte data uten stasjonsidentifikator.\n\nAngi en Sender ID i WSLink-appen, eller en ID-parameter i stasjonens konfigurasjon. Meldingen forsvinner av seg selv så snart en forespørsel fra {ip} godtas."
    },
    "legacy_entity_ids": {
      "title": "Entity IDs repeat the station name",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Shorten the entity IDs",
            "description": "Up to version 1.0.8 this integration built entity IDs that carry the station name twice, such as `{example_old}`. New stations no longer do.\n\n**{count} entities** can be renamed, for example to `{example_new}`.\n\nHistory and long-term statistics follow the rename automatically. **Automations, scripts, scenes and dashboards do not** — you will have to update anything that refers to the old IDs yourself.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    },
    "legacy_status_sensors": {
      "title": "Connection and leak readings are still numbers",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Convert to binary sensors",
            "description": "Connection and water leak readings are reported as 1 or 0. Up to version 1.0.8 they were exposed as numeric sensors, such as `{example}`, which cannot be used with the standard leak cards and alerts of Home Assistant. New stations now get binary sensors showing **Wet / Dry** and **Connected / Disconnected**.\n\n**{count} entities** can be converted. Battery levels are not affected: they stay percentages, where the low-battery alerts work on them.\n\nChanging platform is not a rename, so the old entities are removed and rebuilt as `binary_sensor`. **Their recorded history is lost** — these readings have no long-term statistics, so only the raw history is affected — and **automations, scripts, scenes and dashboards pointing at them must be updated**. The new entities appear on the station's next upload.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    }
  },
  "exceptions": {
    "no_wind_direction": {
      "message": "Stasjonen {device} har ennå ikke sendt noen vindretning, så det er ingenting å kalibrere mot. Vent på neste sending og prøv igjen."
    }
  },
