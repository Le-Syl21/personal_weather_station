{
  "config": {
    "step": {
      "user": {
        "title": "Особиста метеостанція",
        "description": "Задайте тут ключ станції, який ваші метеостанції мають передавати, щоб їхні дані не відхилялися. Якщо залишити поле порожнім, прийматимуться всі запити.",
        "data": {
          "password": "Ключ станції"
        }
      }
    },
    "abort": {
      "single_instance_allowed": "Уже налаштовано. Один екземпляр обслуговує всі метеостанції."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Особиста метеостанція",
        "description": "Задайте тут ключ станції, який ваші метеостанції мають передавати, щоб їхні дані не відхилялися. Якщо залишити поле порожнім, прийматимуться всі запити.",
        "data": {
          "password": "Ключ станції",
          "availability_timeout": "Позначати як недоступне через (хвилин)",
          "debug": "Записувати кожен вхідний запит"
        },
        "data_description": {
          "availability_timeout": "Як довго станція може мовчати, перш ніж її датчики буде позначено як недоступні. 0 — ніколи не позначати.",
          "debug": "Записує повний вміст кожного запиту в журнал Home Assistant. Корисно під час налаштування станції, згодом заважає."
        }
      }
    }
  },
  "issues": {
    "invalid_station_key": {
      "title": "Метеостанцію відхилено: неправильний ключ станції",
      "description": "Метеостанція за адресою {ip} спробувала надіслати дані як `{station_id}`, не передавши очікуваний ключ станції.\n\nПеревірте, чи ключ, заданий у станції або в застосунку WSLink, збігається із зазначеним у цій інтеграції. Це повідомлення зникне саме, щойно запит з {ip} буде прийнято."
    },
    "missing_device_id": {
      "title": "Метеостанцію відхилено: немає ідентифікатора станції",
      "description": "Метеостанція за адресою {ip} надіслала дані без ідентифікатора станції.\n\nЗадайте Sender ID у застосунку WSLink або параметр ID у налаштуваннях станції. Це повідомлення зникне саме, щойно запит з {ip} буде прийнято."
    },
    "legacy_entity_ids": {
      "title": "Entity IDs repeat the station name",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Shorten the entity IDs",
            "description": "Up to version 1.0.8 this integration built entity IDs that carry the station name twice, such as `{example_old}`. New stations no longer do.\n\n**{count} entities** can be renamed, for example to `{example_new}`.\n\nHistory and long-term statistics follow the rename automatically. **Automations, scripts, scenes and dashboards do not** — you will have to update anything that refers to the old IDs yourself.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    },
    "legacy_status_sensors": {
      "title": "Connection and leak readings are still numbers",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Convert to binary sensors",
            "description": "Connection and water leak readings are reported as 1 or 0. Up to version 1.0.8 they were exposed as numeric sensors, such as `{example}`, which cannot be used with the standard leak cards and alerts of Home Assistant. New stations now get binary sensors showing **Wet / Dry** and **Connected / Disconnected**.\n\n**{count} entities** can be converted. Battery levels are not affected: they stay percentages, where the low-battery alerts work on them.\n\nChanging platform is not a rename, so the old entities are removed and rebuilt as `binary_sensor`. **Their recorded history is lost** — these readings have no long-term statistics, so only the raw history is affected — and **automations, scripts, scenes and dashboards pointing at them must be updated**. The new entities appear on the station's next upload.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    }
  },
  "exceptions": {
    "no_wind_direction": {
      "message": "Станція {device} ще не передала напрямок вітру, тож немає за чим калібрувати. Дочекайтеся наступного надсилання і спробуйте знову."
    }
  },
