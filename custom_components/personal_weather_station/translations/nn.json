{
  "config": {
    "step": {
      "user": {
        "title": "Personleg vêrstasjon",
        "description": "Oppgi her ein stasjonsnøkkel som vêrstasjonane dine må sende med for at dataa deira ikkje skal bli avviste. Lèt du feltet stå tomt, blir alle førespurnader godtekne.",
        "data": {
          "password": "Stasjonsnøkkel"
        }
      }
    },
    "abort": {
      "single_instance_allowed": "Allereie konfigurert. Éin einaste instans betener alle vêrstasjonar."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Personleg vêrstasjon",
        "description": "Oppgi her ein stasjonsnøkkel som vêrstasjonane dine må sende med for at dataa deira ikkje skal bli avviste. Lèt du feltet stå tomt, blir alle førespurnader godtekne.",
        "data": {
          "password": "Stasjonsnøkkel",
          "availability_timeout": "Merk som utilgjengeleg etter (minutt)",
          "debug": "Logg kvar innkomande førespurnad"
        },
        "data_description": {
          "availability_timeout": "Kor lenge ein stasjon kan vere tagal før sensorane blir merkte som utilgjengelege. 0 for aldri å merke dei.",
          "debug": "Skriv heile innhaldet i kvar førespurnad til Home Assistant-loggen. Nyttig medan ein stasjon blir sett opp, støyande etterpå."
        }
      }
    }
  },
  "issues": {
    "invalid_station_key": {
      "title": "Vêrstasjon avvist: feil stasjonsnøkkel",
      "description": "Ein vêrstasjon på {ip} prøvde å sende data som `{station_id}` utan å sende med forventa stasjonsnøkkel.\n\nKontroller at nøkkelen som er sett i stasjonen eller i WSLink-appen stemmer med den som er oppgitt i denne integrasjonen. Meldinga forsvinn av seg sjølv så snart ein førespurnad frå {ip} blir godteken."
    },
    "missing_device_id": {
      "title": "Vêrstasjon avvist: ingen stasjonsidentifikator",
      "description": "Ein vêrstasjon på {ip} sende data utan stasjonsidentifikator.\n\nOppgi ein Sender ID i WSLink-appen, eller ein ID-parameter i konfigurasjonen til stasjonen. Meldinga forsvinn av seg sjølv så snart ein førespurnad frå {ip} blir godteken."
    },
    "legacy_entity_ids": {
      "title": "Entity IDs repeat the station name",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Shorten the entity IDs",
            "description": "Up to version 1.0.8 this integration built entity IDs that carry the station name twice, such as `{example_old}`. New stations no longer do.\n\n**{count} entities** can be renamed, for example to `{example_new}`.\n\nHistory and long-term statistics follow the rename automatically. **Automations, scripts, scenes and dashboards do not** — you will have to update anything that refers to the old IDs yourself.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    },
    "legacy_status_sensors": {
      "title": "Connection and leak readings are still numbers",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Convert to binary sensors",
            "description": "Connection and water leak readings are reported as 1 or 0. Up to version 1.0.8 they were exposed as numeric sensors, such as `{example}`, which cannot be used with the standard leak cards and alerts of Home Assistant. New stations now get binary sensors showing **Wet / Dry** and **Connected / Disconnected**.\n\n**{count} entities** can be converted. Battery levels are not affected: they stay percentages, where the low-battery alerts work on them.\n\nChanging platform is not a rename, so the old entities are removed and rebuilt as `binary_sensor`. **Their recorded history is lost** — these readings have no long-term statistics, so only the raw history is affected — and **automations, scripts, scenes and dashboards pointing at them must be updated**. The new entities appear on the station's next upload.\n\nIf you would rather keep them as they are, ignore this repair."
          }
        }
      }
    }
  },
  "exceptions": {
    "no_wind_direction": {
      "message": "Stasjonen {device} har enno ikkje sendt nokon vindretning, så det er ingenting å kalibrere mot. Vent på neste sending og prøv igjen."
    }
  },
